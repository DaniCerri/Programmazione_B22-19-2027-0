% ==============================================================================
% LISTATI DI CODICE (LISTINGS)
% ==============================================================================
\RequirePackage{listings}
\lstset{
  backgroundcolor=\color{CodeBg},
  basicstyle=\ttfamily\small\color{PiazzaDark},
  keywordstyle=\bfseries\color{PiazzaPrimary},
  commentstyle=\itshape\color{PiazzaGray},
  stringstyle=\color{BoxGreen},
  identifierstyle=\color{PiazzaDark},
  numbers=left,
  numberstyle=\tiny\color{PiazzaLightGray},
  numbersep=9pt,
  frame=single,
  rulecolor=\color{PiazzaBorder},
  frameround=tttt,
  breaklines=true,
  breakatwhitespace=true,
  showstringspaces=false,
  tabsize=2,
  captionpos=b,
  xleftmargin=12pt,
  framexleftmargin=8pt
}

% ==============================================================================
% INDICE CLICCABILE E COLLEGAMENTI IPERTESTUALI (HYPERREF)
% ==============================================================================
\RequirePackage{bookmark}
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=PiazzaPrimary,       % Cliccando sull'indice si naviga al capitolo col colore primario
  anchorcolor=PiazzaDark,
  citecolor=BoxGreen,
  filecolor=BoxBlue,
  menucolor=PiazzaPrimary,
  runcolor=PiazzaPrimary,
  urlcolor=BoxBlue,
  linktoc=all,                   % Sia il titolo che il numero di pagina sono cliccabili!
  pdfstartview={FitH},
  pdfpagelayout={SinglePage},
  pdfborder={0 0 0},
  bookmarksnumbered=true,
  bookmarksopen=true
}

\endinput
